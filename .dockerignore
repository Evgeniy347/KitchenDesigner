# Docker build context = repo root (see server/Dockerfile). Keep it small: only
# server/ and Assets/Scripts/Core/MCP/Contract are actually COPY-ed into the image.

# Unity engine artifacts (the big ones)
Library/
Temp/
Logs/
UserSettings/
Builds/
Build_Debug/
obj/
bin/

# nested build outputs
**/bin/
**/obj/
**/.vs/

# node / TS
**/node_modules/
mcp-server/dist/

# server-local state / artifacts (regenerated or deployed separately)
server/publish/
server/data/
server/webgl/

# vcs & misc
.git/
.github/
*.user
