<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>McpContractGen</RootNamespace>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableNETAnalyzers>false</EnableNETAnalyzers>
  </PropertyGroup>

  <!--
    SINGLE SOURCE OF TRUTH. These .cs files physically live under Assets/ and are
    compiled by Unity (KitchenDesigner.Runtime asmdef). The generator links the
    SAME files so the Zod tool table it emits cannot drift from the contract.
  -->
  <ItemGroup>
    <Compile Include="..\..\Assets\Scripts\Core\MCP\Contract\*.cs">
      <Link>Contract\%(Filename)%(Extension)</Link>
    </Compile>
  </ItemGroup>

</Project>
