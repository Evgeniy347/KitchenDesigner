<linker>
  <!-- Свойства элементов читаются и пишутся ОТРАЖЕНИЕМ (UndoableProperties:
       общий снимок для отмены). Линкер вызовов не видит — без этой строки
       геттеры/сеттеры вырежет, и в собранном плеере «Отменить» тихо
       перестанет возвращать свойства. -->
  <assembly fullname="KitchenDesigner.Runtime">
    <type fullname="KitchenDesigner.Core.*" preserve="all" />
  </assembly>
  <assembly fullname="Unity.TextMeshPro" preserve="all" />
  <assembly fullname="UnityEngine.CoreModule">
    <type fullname="UnityEngine.Font" preserve="all" />
  </assembly>
  <assembly fullname="UnityEngine.PhysicsModule">
    <type fullname="UnityEngine.CapsuleCollider" preserve="all" />
  </assembly>
  <assembly fullname="UnityEngine.UI">
    <type fullname="UnityEngine.UI.Text" preserve="all" />
  </assembly>
</linker>
