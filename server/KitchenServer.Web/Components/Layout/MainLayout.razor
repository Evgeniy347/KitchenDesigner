@inherits LayoutComponentBase
@using Microsoft.AspNetCore.Components.Authorization
@inject NavigationManager Navigation

<div class="layout">
    <AuthorizeView>
        <Authorized>
            <nav class="top-nav">
                <div class="nav-left">
                    <a href="/" class="nav-brand">KitchenDesigner</a>
                    <NavLink href="/projects" class="nav-link" ActiveClass="nav-link-active">
                        Projects
                    </NavLink>
                </div>
                <div class="nav-right">
                    <span class="nav-user">@context.User.Identity?.Name</span>
                    <a href="/auth/logout" class="nav-link nav-logout">Logout</a>
                </div>
            </nav>
        </Authorized>
    </AuthorizeView>

    <main class="main-content">
        @Body
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

<style>
    :root { --bg: #1a1a2e; --surface: #1e1e2e; --border: #2a2a3e; --accent: #3a5afe; }

    html, body { margin: 0; padding: 0; background: var(--bg); color: #ccc; font-family: sans-serif; }

    .layout { display: flex; flex-direction: column; min-height: 100vh; }

    .top-nav {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 0 24px;
        height: 48px;
        background: var(--surface);
        border-bottom: 1px solid var(--border);
        flex-shrink: 0;
    }
    .nav-left, .nav-right { display: flex; align-items: center; gap: 16px; }
    .nav-brand { color: #fff; font-weight: 700; font-size: 16px; text-decoration: none; }
    .nav-link { color: #888; text-decoration: none; font-size: 14px; padding: 4px 8px; border-radius: 4px; transition: color 0.15s; }
    .nav-link:hover { color: #fff; }
    .nav-link-active { color: var(--accent); background: #3a5afe1a; }
    .nav-user { color: #aaa; font-size: 13px; }
    .nav-logout { color: #ff6b6b; }

    .main-content { flex: 1; }
</style>
