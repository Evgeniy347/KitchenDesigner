@inherits LayoutComponentBase
@using Microsoft.AspNetCore.Components.Authorization
@using KitchenServer.Web.Services
@inject NavigationManager Navigation
@inject AdminEmailsService AdminEmails
@inject ImpersonationService Impersonation

<div class="layout">
    <AuthorizeView>
        <Authorized>
            <nav class="top-nav @(Impersonation.IsImpersonating ? "top-nav-impersonating" : "")">
                <div class="nav-left">
                    <a href="/" class="nav-brand">KitchenDesigner</a>
                    <NavLink href="/projects" class="nav-link" ActiveClass="nav-link-active">
                        Projects
                    </NavLink>
                    @if (AdminEmails.IsAdmin(context.User.Identity?.Name) && !Impersonation.IsImpersonating)
                    {
                        <NavLink href="/admin/users" class="nav-link" ActiveClass="nav-link-active">
                            Admin
                        </NavLink>
                    }
                </div>
                <EditorNavInfo @rendermode="InteractiveServer" />
                <div class="nav-right">
                    @if (Impersonation.IsImpersonating)
                    {
                        <span class="nav-impersonation-badge" title="Режим имперсонализации">
                            <i class="bi bi-person-check"></i> @context.User.Identity?.Name
                        </span>
                        <form method="post" action="/admin/stop-impersonation" class="logout-form">
                            <AntiforgeryToken />
                            <button type="submit" class="nav-link nav-stop-impersonation" title="Вернуться к себе">
                                <i class="bi bi-box-arrow-right"></i>
                            </button>
                        </form>
                    }
                    else
                    {
                        <NavLink href="/profile" class="nav-link" ActiveClass="nav-link-active">
                            @context.User.Identity?.Name
                        </NavLink>
                        <form method="post" action="/auth/logout/perform" class="logout-form">
                            <AntiforgeryToken />
                            <button type="submit" class="nav-link nav-logout">Logout</button>
                        </form>
                    }
                </div>
            </nav>
        </Authorized>
    </AuthorizeView>

    <main class="main-content">
        @Body
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

