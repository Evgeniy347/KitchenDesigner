@inherits LayoutComponentBase
@using Microsoft.AspNetCore.Components.Authorization
@inject NavigationManager Navigation

<div class="layout">
    <AuthorizeView>
        <Authorized>
            <nav class="top-nav">
                <div class="nav-left">
                    <a href="/" class="nav-brand">KitchenDesigner</a>
                    <NavLink href="/projects" class="nav-link" ActiveClass="nav-link-active">
                        Projects
                    </NavLink>
                    <NavLink href="/mcp-panel" class="nav-link" ActiveClass="nav-link-active">
                        MCP
                    </NavLink>
                </div>
                <EditorNavInfo @rendermode="InteractiveServer" />
                <div class="nav-right">
                    <NavLink href="/profile" class="nav-link" ActiveClass="nav-link-active">
                        @context.User.Identity?.Name
                    </NavLink>
                    <form method="post" action="/auth/logout/perform" class="logout-form">
                        <AntiforgeryToken />
                        <button type="submit" class="nav-link nav-logout">Logout</button>
                    </form>
                </div>
            </nav>
        </Authorized>
    </AuthorizeView>

    <main class="main-content">
        @Body
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

