@using KitchenServer.Web.Services
@implements IDisposable
@inject EditorNavState NavState
@inject IJSRuntime JS

@* Interactive island in the static top-nav: shows the open project plus its MCP
   project key + a status light (red until an agent authenticates, then green).
   Empty on every other page. *@
@if (NavState.HasProject)
{
    <div class="editor-nav-info">
        <span class="editor-project-name">@NavState.ProjectName</span>
        <span class="editor-project-id" title="Project ID: @NavState.ProjectId">
            ID: @NavState.ProjectId!.Value.ToString()[..8]
        </span>
        @if (!string.IsNullOrEmpty(NavState.McpKey))
        {
            <span class="mcp-key-box" title="MCP project key — copy it and give it to the AI agent">
                <span class="mcp-light @(NavState.AgentConnected ? "mcp-light-on" : "mcp-light-off")"
                      title="@(NavState.AgentConnected ? "AI agent connected" : "No agent connected")"></span>
                <span class="mcp-key-label">MCP key</span>
                <code class="mcp-key-value">@NavState.McpKey</code>
                <button type="button" class="mcp-key-copy" @onclick="CopyKey" title="Copy key">⧉</button>
                <a href="/mcp-guide" class="mcp-key-help" title="Как подключить ИИ-агента">?</a>
            </span>
        }
    </div>
}

@code {
    protected override void OnInitialized() => NavState.Changed += OnChanged;

    private void OnChanged() => InvokeAsync(StateHasChanged);

    private async Task CopyKey()
    {
        if (string.IsNullOrEmpty(NavState.McpKey)) return;
        try { await JS.InvokeVoidAsync("navigator.clipboard.writeText", NavState.McpKey); }
        catch { /* clipboard unavailable (non-HTTPS / unsupported) */ }
    }

    public void Dispose() => NavState.Changed -= OnChanged;
}
