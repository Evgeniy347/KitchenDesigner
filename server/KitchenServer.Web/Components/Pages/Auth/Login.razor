@page "/auth/login"
@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Identity
@inject SignInManager<IdentityUser> SignInManager
@inject NavigationManager Navigation

@* Static SSR on purpose: PasswordSignInAsync sets the auth cookie, which is only
   possible during a regular HTTP request — not inside an interactive circuit. *@

<PageTitle>Вход — KitchenDesigner</PageTitle>

<div class="auth-form">
    <h2>Вход</h2>

    <EditForm Model="Input" method="post" OnValidSubmit="HandleLogin" FormName="login">
        <DataAnnotationsValidator />

        <InputText @bind-Value="Input.Email" type="email" placeholder="Email" class="input" autocomplete="username" />
        <InputText @bind-Value="Input.Password" type="password" placeholder="Пароль" class="input" autocomplete="current-password" />

        @if (!string.IsNullOrEmpty(_error))
        {
            <div class="error">@_error</div>
        }
        <ValidationSummary class="error" />

        <button type="submit" class="btn">Войти</button>
    </EditForm>

    <p class="link">
        Нет аккаунта? <a href="/auth/register">Регистрация</a>
    </p>
</div>

@code {
    [SupplyParameterFromForm]
    private InputModel Input { get; set; } = default!;

    [SupplyParameterFromQuery]
    private string? ReturnUrl { get; set; }

    private string _error = "";

    protected override void OnInitialized() => Input ??= new();

    private async Task HandleLogin()
    {
        var result = await SignInManager.PasswordSignInAsync(
            Input.Email, Input.Password, isPersistent: Input.RememberMe, lockoutOnFailure: true);

        if (result.Succeeded)
        {
            // Only same-site relative paths — never redirect to an external URL.
            var target = !string.IsNullOrEmpty(ReturnUrl) && ReturnUrl.StartsWith('/') && !ReturnUrl.StartsWith("//")
                ? ReturnUrl
                : "/";
            Navigation.NavigateTo(target);
        }
        else if (result.IsLockedOut)
        {
            _error = "Слишком много неудачных попыток. Аккаунт временно заблокирован, попробуйте через несколько минут.";
        }
        else
        {
            _error = "Неверный email или пароль";
        }
    }

    private sealed class InputModel
    {
        [Required(ErrorMessage = "Email обязателен")]
        [EmailAddress(ErrorMessage = "Некорректный email")]
        public string Email { get; set; } = "";

        [Required(ErrorMessage = "Пароль обязателен")]
        public string Password { get; set; } = "";

        public bool RememberMe { get; set; } = true;
    }
}

<style>
    .auth-form {
        max-width: 360px;
        margin: 80px auto;
        padding: 32px;
        background: #1e1e2e;
        border-radius: 8px;
        color: #ccc;
    }
    h2 { margin: 0 0 20px; color: #fff; font-size: 20px; }
    .input {
        width: 100%;
        padding: 10px;
        margin-bottom: 12px;
        background: #2a2a3e;
        border: 1px solid #3a3a5e;
        border-radius: 4px;
        color: #fff;
        font-size: 14px;
        box-sizing: border-box;
    }
    .btn {
        width: 100%;
        padding: 10px;
        background: #3a5afe;
        color: #fff;
        border: none;
        border-radius: 4px;
        cursor: pointer;
        font-size: 14px;
    }
    .btn:hover { background: #2e4ecc; }
    .btn:disabled { opacity: 0.6; }
    .error { background: #5a1a1a; padding: 8px; border-radius: 4px; margin-bottom: 12px; font-size: 13px; }
    .error ul { margin: 0; padding-left: 18px; }
    .link { text-align: center; margin-top: 16px; font-size: 13px; }
    .link a { color: #3a5afe; }
</style>
