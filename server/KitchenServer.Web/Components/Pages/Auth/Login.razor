@page "/auth/login"
@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Identity
@inject SignInManager<IdentityUser> SignInManager
@inject NavigationManager Navigation

@* Static SSR on purpose: PasswordSignInAsync sets the auth cookie, which is only
   possible during a regular HTTP request — not inside an interactive circuit. *@

<PageTitle>Вход — KitchenDesigner</PageTitle>

<div class="auth-form">
    <h2>Вход</h2>

    <EditForm Model="Input" method="post" OnValidSubmit="HandleLogin" FormName="login">
        <DataAnnotationsValidator />

        <InputText @bind-Value="Input.Email" type="email" placeholder="Email" class="auth-input" autocomplete="username" />
        <InputText @bind-Value="Input.Password" type="password" placeholder="Пароль" class="auth-input" autocomplete="current-password" />

        @if (!string.IsNullOrEmpty(_error))
        {
            <div class="auth-error">@_error</div>
        }
        <ValidationSummary class="auth-error" />

        <button type="submit" class="auth-btn">Войти</button>
    </EditForm>

    <p class="auth-link">
        Нет аккаунта? <a href="/auth/register">Регистрация</a>
    </p>
</div>

@code {
    [SupplyParameterFromForm]
    private InputModel Input { get; set; } = default!;

    [SupplyParameterFromQuery]
    private string? ReturnUrl { get; set; }

    private string _error = "";

    protected override void OnInitialized() => Input ??= new();

    private async Task HandleLogin()
    {
        var result = await SignInManager.PasswordSignInAsync(
            Input.Email, Input.Password, isPersistent: Input.RememberMe, lockoutOnFailure: true);

        if (result.Succeeded)
        {
            // Only same-site relative paths — never redirect to an external URL.
            var target = !string.IsNullOrEmpty(ReturnUrl) && ReturnUrl.StartsWith('/') && !ReturnUrl.StartsWith("//")
                ? ReturnUrl
                : "/";
            Navigation.NavigateTo(target);
        }
        else if (result.IsLockedOut)
        {
            _error = "Слишком много неудачных попыток. Аккаунт временно заблокирован, попробуйте через несколько минут.";
        }
        else
        {
            _error = "Неверный email или пароль";
        }
    }

    private sealed class InputModel
    {
        [Required(ErrorMessage = "Email обязателен")]
        [EmailAddress(ErrorMessage = "Некорректный email")]
        public string Email { get; set; } = "";

        [Required(ErrorMessage = "Пароль обязателен")]
        public string Password { get; set; } = "";

        public bool RememberMe { get; set; } = true;
    }
}

