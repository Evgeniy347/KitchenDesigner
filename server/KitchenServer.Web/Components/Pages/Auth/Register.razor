@page "/auth/register"
@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Identity
@inject SignInManager<IdentityUser> SignInManager
@inject UserManager<IdentityUser> UserManager
@inject NavigationManager Navigation

@* Static SSR: SignInAsync sets the auth cookie during a regular HTTP request. *@

<PageTitle>Регистрация — KitchenDesigner</PageTitle>

<div class="auth-form">
    <h2>Регистрация</h2>

    <EditForm Model="Input" method="post" OnValidSubmit="HandleRegister" FormName="register">
        <DataAnnotationsValidator />

        <InputText @bind-Value="Input.Email" type="email" placeholder="Email" class="input" autocomplete="username" />
        <InputText @bind-Value="Input.Password" type="password" placeholder="Пароль" class="input" autocomplete="new-password" />
        <InputText @bind-Value="Input.ConfirmPassword" type="password" placeholder="Подтвердите пароль" class="input" autocomplete="new-password" />

        @if (!string.IsNullOrEmpty(_error))
        {
            <div class="error">@_error</div>
        }
        <ValidationSummary class="error" />

        <button type="submit" class="btn">Создать аккаунт</button>
    </EditForm>

    <p class="link">
        Уже есть аккаунт? <a href="/auth/login">Войти</a>
    </p>
</div>

@code {
    [SupplyParameterFromForm]
    private InputModel Input { get; set; } = default!;

    private string _error = "";

    protected override void OnInitialized() => Input ??= new();

    private async Task HandleRegister()
    {
        var user = new IdentityUser { UserName = Input.Email, Email = Input.Email };
        var result = await UserManager.CreateAsync(user, Input.Password);

        if (result.Succeeded)
        {
            await SignInManager.SignInAsync(user, isPersistent: true);
            Navigation.NavigateTo("/");
        }
        else
        {
            _error = string.Join("; ", result.Errors.Select(e => e.Description));
        }
    }

    private sealed class InputModel
    {
        [Required(ErrorMessage = "Email обязателен")]
        [EmailAddress(ErrorMessage = "Некорректный email")]
        public string Email { get; set; } = "";

        [Required(ErrorMessage = "Пароль обязателен")]
        [MinLength(6, ErrorMessage = "Пароль должен быть не менее 6 символов")]
        public string Password { get; set; } = "";

        [Compare(nameof(Password), ErrorMessage = "Пароли не совпадают")]
        public string ConfirmPassword { get; set; } = "";
    }
}

<style>
    .auth-form {
        max-width: 360px;
        margin: 80px auto;
        padding: 32px;
        background: #1e1e2e;
        border-radius: 8px;
        color: #ccc;
    }
    h2 { margin: 0 0 20px; color: #fff; font-size: 20px; }
    .input {
        width: 100%;
        padding: 10px;
        margin-bottom: 12px;
        background: #2a2a3e;
        border: 1px solid #3a3a5e;
        border-radius: 4px;
        color: #fff;
        font-size: 14px;
        box-sizing: border-box;
    }
    .btn {
        width: 100%;
        padding: 10px;
        background: #3a5afe;
        color: #fff;
        border: none;
        border-radius: 4px;
        cursor: pointer;
        font-size: 14px;
    }
    .btn:hover { background: #2e4ecc; }
    .btn:disabled { opacity: 0.6; }
    .error { background: #5a1a1a; padding: 8px; border-radius: 4px; margin-bottom: 12px; font-size: 13px; }
    .error ul { margin: 0; padding-left: 18px; }
    .link { text-align: center; margin-top: 16px; font-size: 13px; }
    .link a { color: #3a5afe; }
</style>
