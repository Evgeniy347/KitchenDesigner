@page "/auth/logout"

@* GET shows a confirmation; actual sign-out is POST to /auth/logout/perform *@

<PageTitle>Выход — KitchenDesigner</PageTitle>

<div class="auth-form">
    <h2>Выход</h2>
    <p>Выйти из аккаунта?</p>

    <form method="post" action="/auth/logout/perform">
        <AntiforgeryToken />
        <button type="submit" class="auth-btn auth-btn-danger">Выйти</button>
    </form>

    <p class="auth-link"><a href="/">Отмена</a></p>
</div>

