@page "/profile"
@attribute [Authorize]
@using System.ComponentModel.DataAnnotations
@using System.Security.Claims
@using KitchenServer.Web.Data
@using KitchenServer.Web.Services
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@inject UserManager<IdentityUser> UserManager
@inject SignInManager<IdentityUser> SignInManager
@inject IDbContextFactory<AppDbContext> DbFactory
@inject ProjectStorageService Storage

@* Static SSR: ChangePasswordAsync + RefreshSignInAsync re-issue the auth cookie,
   which requires a regular HTTP request. *@

<PageTitle>Профиль — KitchenDesigner</PageTitle>

<div class="profile-page">
    <h1>Профиль</h1>

    @if (_user is null)
    {
        <p>Загрузка...</p>
    }
    else
    {
        <section class="profile-card">
            <h2>Аккаунт</h2>
            <div class="profile-row"><span class="profile-label">Email:</span> @_user.Email</div>
            <div class="profile-row"><span class="profile-label">Проектов:</span> @_projectCount</div>
            <div class="profile-row"><span class="profile-label">Хранилище:</span> @FormatBytes(_usageBytes)</div>
        </section>

        <section class="profile-card">
            <h2>Смена пароля</h2>

            <EditForm Model="Input" method="post" OnValidSubmit="HandleChangePassword" FormName="change-password">
                <DataAnnotationsValidator />

                <InputText @bind-Value="Input.CurrentPassword" type="password" placeholder="Текущий пароль"
                           class="profile-input" autocomplete="current-password" />
                <InputText @bind-Value="Input.NewPassword" type="password" placeholder="Новый пароль"
                           class="profile-input" autocomplete="new-password" />
                <InputText @bind-Value="Input.ConfirmPassword" type="password" placeholder="Подтвердите новый пароль"
                           class="profile-input" autocomplete="new-password" />

                @if (!string.IsNullOrEmpty(_error))
                {
                    <div class="profile-error">@_error</div>
                }
                @if (!string.IsNullOrEmpty(_success))
                {
                    <div class="profile-success">@_success</div>
                }
                <ValidationSummary class="profile-error" />

                <button type="submit" class="profile-btn">Сменить пароль</button>
            </EditForm>
        </section>
    }
</div>

@code {
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromForm]
    private InputModel Input { get; set; } = default!;

    private IdentityUser? _user;
    private int _projectCount;
    private long _usageBytes;
    private string _error = "";
    private string _success = "";

    protected override async Task OnInitializedAsync()
    {
        Input ??= new();
        _user = await UserManager.GetUserAsync(HttpContext.User);
        if (_user is null)
            return;

        await using var db = await DbFactory.CreateDbContextAsync();
        _projectCount = await db.Projects.CountAsync(p => p.UserId == _user.Id && !p.IsArchived);
        _usageBytes = Storage.GetUsageBytes(_user.Id);
    }

    private async Task HandleChangePassword()
    {
        _error = "";
        _success = "";
        if (_user is null)
            return;

        var result = await UserManager.ChangePasswordAsync(_user, Input.CurrentPassword, Input.NewPassword);
        if (result.Succeeded)
        {
            // Re-issue the cookie: the password change rotated the security stamp,
            // which would otherwise invalidate this session within minutes.
            await SignInManager.RefreshSignInAsync(_user);
            _success = "Пароль изменён";
            Input = new InputModel();
        }
        else
        {
            _error = string.Join("; ", result.Errors.Select(e =>
                e.Code == "PasswordMismatch" ? "Неверный текущий пароль" : e.Description));
        }
    }

    private static string FormatBytes(long bytes) => bytes switch
    {
        < 1024 => $"{bytes} B",
        < 1024 * 1024 => $"{bytes / 1024.0:F1} KB",
        _ => $"{bytes / 1048576.0:F1} MB"
    };

    private sealed class InputModel
    {
        [Required(ErrorMessage = "Введите текущий пароль")]
        public string CurrentPassword { get; set; } = "";

        [Required(ErrorMessage = "Введите новый пароль")]
        [MinLength(6, ErrorMessage = "Пароль должен быть не менее 6 символов")]
        public string NewPassword { get; set; } = "";

        [Compare(nameof(NewPassword), ErrorMessage = "Пароли не совпадают")]
        public string ConfirmPassword { get; set; } = "";
    }
}

