@page "/projects/{ProjectGroupId:guid}/versions"
@rendermode InteractiveServer
@attribute [Authorize]
@using Microsoft.AspNetCore.Components.Authorization
@using KitchenServer.Web.Data
@using KitchenServer.Web.Data.Entities
@using KitchenServer.Web.Services
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<AppDbContext> DbFactory
@inject ProjectStorageService Storage
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthProvider

<PageTitle>Version History — KitchenDesigner</PageTitle>

<div class="versions-page">
    <div class="versions-header">
        <button class="versions-btn-back" @onclick="GoBack" title="Back to projects">
            <i class="bi bi-arrow-left"></i> Back
        </button>
        <h1>Version History</h1>
    </div>

    @if (_loading)
    {
        <p class="versions-loading">Loading...</p>
    }
    else if (!string.IsNullOrEmpty(_error))
    {
        <p class="versions-error">@_error</p>
    }
    else
    {
        <div class="versions-project-name">
            Project: <strong>@_projectName</strong>
        </div>

        <div class="versions-table-wrapper">
            <table class="versions-table">
                <thead>
                    <tr>
                        <th>Version</th>
                        <th>Name</th>
                        <th>Created</th>
                        <th>Updated</th>
                        <th>Deleted</th>
                        <th>Status</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var v in PagedVersions)
                    {
                        <tr class="@(v.IsLatest ? "versions-row-latest" : "") @(v.IsDeleted ? "versions-row-deleted" : "")">
                            <td>#@v.Version</td>
                            <td class="versions-cell-name">@v.Name</td>
                            <td>@v.CreatedAt.ToString("MMM dd, yyyy HH:mm")</td>
                            <td>@v.UpdatedAt.ToString("MMM dd, yyyy HH:mm")</td>
                            <td>@(v.DeletedAt?.ToString("MMM dd, yyyy HH:mm") ?? "—")</td>
                            <td>
                                @if (v.IsDeleted)
                                {
                                    <span class="versions-badge versions-badge-deleted">deleted</span>
                                }
                                else if (v.IsLatest)
                                {
                                    <span class="versions-badge versions-badge-latest">current</span>
                                }
                                else
                                {
                                    <span class="versions-badge versions-badge-old">old</span>
                                }
                            </td>
                            <td>
                                @if (!v.IsLatest && !v.IsDeleted)
                                {
                                    <button class="versions-btn-restore"
                                            @onclick="() => RestoreVersion(v)"
                                            disabled="@(_restoringId == v.Id)">
                                        @(_restoringId == v.Id ? "Restoring..." : "Restore")
                                    </button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="versions-pagination">
            <button class="versions-btn-page" @onclick="() => GoToPage(_page - 1)" disabled="@(_page <= 0)">
                Previous
            </button>
            <span class="versions-page-info">
                Page @(_page + 1) of @(_totalPages)
            </span>
            <button class="versions-btn-page" @onclick="() => GoToPage(_page + 1)" disabled="@(_page >= _totalPages - 1)">
                Next
            </button>
        </div>

        <div class="versions-footer">
            Total versions: <strong>@_allVersions.Count</strong>
            @if (_totalPages > 1)
            {
                <span>(showing @PagedVersions.Count on this page)</span>
            }
        </div>
    }
</div>

@code {
    [Parameter] public Guid ProjectGroupId { get; set; }

    private readonly List<VersionInfo> _allVersions = new();
    private string _projectName = "";
    private string _error = "";
    private bool _loading = true;
    private Guid? _restoringId;

    private int _page;
    private int _totalPages;
    private const int PageSize = 100;

    private List<VersionInfo> PagedVersions =>
        _allVersions.Skip(_page * PageSize).Take(PageSize).ToList();

    protected override async Task OnInitializedAsync()
    {
        await LoadVersions();
    }

    private async Task LoadVersions()
    {
        _loading = true;
        _error = "";
        try
        {
            var authState = await AuthProvider.GetAuthenticationStateAsync();
            var userId = authState.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
            if (userId is null)
            {
                _error = "Not authenticated.";
                return;
            }

            await using var db = await DbFactory.CreateDbContextAsync();
            var versions = await db.Projects
                .Where(p => p.ProjectGroupId == ProjectGroupId && p.UserId == userId)
                .OrderByDescending(p => p.Version)
                .Select(p => new VersionInfo(
                    p.Id, p.ProjectGroupId, p.UserId, p.Name, p.Version,
                    p.IsLatest, p.IsDeleted, p.JsonData,
                    p.CreatedAt, p.UpdatedAt, p.DeletedAt))
                .ToListAsync();

            if (versions.Count == 0)
            {
                _error = "Project not found.";
                return;
            }

            _allVersions.AddRange(versions);
            _projectName = versions.First().Name;
            _totalPages = (int)Math.Ceiling((double)_allVersions.Count / PageSize);
        }
        catch (Exception ex)
        {
            _error = $"Failed to load version history: {ex.Message}";
        }
        finally
        {
            _loading = false;
        }
    }

    private void GoToPage(int page)
    {
        if (page < 0 || page >= _totalPages) return;
        _page = page;
    }

    private async Task RestoreVersion(VersionInfo version)
    {
        _restoringId = version.Id;
        _error = "";
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();

            var current = await db.Projects
                .FirstOrDefaultAsync(p => p.ProjectGroupId == ProjectGroupId
                    && p.UserId == version.UserId && p.IsLatest && !p.IsDeleted);
            if (current is null)
            {
                _error = "Current version not found.";
                return;
            }

            var json = version.JsonData;
            if (json == "{}")
            {
                json = await Storage.Load(ProjectGroupId, version.UserId) ?? "{}";
            }

            var now = DateTime.UtcNow;

            try
            {
                await Storage.Save(ProjectGroupId, version.UserId, json);
            }
            catch (ProjectStorageException ex)
            {
                _error = ex.Message;
                return;
            }

            var newVersion = new Project
            {
                Id = Guid.NewGuid(),
                ProjectGroupId = current.ProjectGroupId,
                UserId = current.UserId,
                Name = current.Name,
                JsonData = json,
                Version = current.Version + 1,
                IsLatest = true,
                IsExample = current.IsExample,
                CreatedAt = current.CreatedAt,
                UpdatedAt = now
            };

            current.IsLatest = false;
            current.UpdatedAt = now;

            db.Projects.Add(newVersion);
            await db.SaveChangesAsync();

            _allVersions.Clear();
            await LoadVersions();
        }
        catch (Exception ex)
        {
            _error = $"Restore failed: {ex.Message}";
        }
        finally
        {
            _restoringId = null;
        }
    }

    private void GoBack() => Navigation.NavigateTo("/projects");

    private record VersionInfo(
        Guid Id, Guid ProjectGroupId, string UserId, string Name, int Version,
        bool IsLatest, bool IsDeleted, string JsonData,
        DateTime CreatedAt, DateTime UpdatedAt, DateTime? DeletedAt);
}
