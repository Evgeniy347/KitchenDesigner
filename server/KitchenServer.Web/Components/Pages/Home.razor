@page "/"
@rendermode InteractiveServer

<PageTitle>KitchenDesigner</PageTitle>

<div class="home-page">
    <div class="home-hero">
        <div class="home-hero-bg"></div>
        <div class="home-hero-content">
            <div class="home-logo-icon">
                <svg viewBox="0 0 64 64" fill="none">
                    <rect x="8" y="20" width="48" height="36" rx="4" stroke="currentColor" stroke-width="2.5" fill="none"/>
                    <rect x="14" y="26" width="14" height="14" rx="2" stroke="currentColor" stroke-width="2" fill="none"/>
                    <rect x="36" y="26" width="14" height="14" rx="2" stroke="currentColor" stroke-width="2" fill="none"/>
                    <rect x="14" y="20" width="36" height="6" rx="1" fill="currentColor" opacity=".25"/>
                    <line x1="32" y1="20" x2="32" y2="56" stroke="currentColor" stroke-width="1.5" opacity=".3"/>
                    <circle cx="32" cy="10" r="5" stroke="currentColor" stroke-width="2" fill="none"/>
                    <line x1="32" y1="15" x2="32" y2="20" stroke="currentColor" stroke-width="1.5" opacity=".3"/>
                </svg>
            </div>
            <h1 class="home-hero-title">KitchenDesigner</h1>
            <p class="home-hero-sub">3D-конструктор кухонной мебели</p>

            <AuthorizeView>
                <Authorized>
                    <p class="home-hero-greeting">С возвращением, <strong>@context.User.Identity?.Name</strong></p>
                    <div class="home-hero-actions">
                        <a href="/projects" class="home-btn home-btn-primary">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 5v14M5 12h14"/></svg>
                            Проекты
                        </a>
                        <a href="/mcp-panel" class="home-btn home-btn-secondary">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="3" width="20" height="14" rx="2"/><path d="M8 21h8M12 17v4"/></svg>
                            MCP-сессии
                        </a>
                        <a href="/profile" class="home-btn home-btn-ghost">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="8" r="4"/><path d="M4 21a8 8 0 0 1 16 0"/></svg>
                            Профиль
                        </a>
                        <a href="/auth/logout" class="home-btn home-btn-danger">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4M16 17l5-5-5-5M21 12H9"/></svg>
                            Выйти
                        </a>
                    </div>
                </Authorized>
                <NotAuthorized>
                    <div class="home-hero-actions">
                        <a href="/auth/login" class="home-btn home-btn-primary">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4M10 17l5-5-5-5M15 12H3"/></svg>
                            Войти
                        </a>
                        <a href="/auth/register" class="home-btn home-btn-secondary">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><line x1="19" y1="8" x2="19" y2="14"/><line x1="22" y1="11" x2="16" y2="11"/></svg>
                            Создать аккаунт
                        </a>
                    </div>
                </NotAuthorized>
            </AuthorizeView>
        </div>
    </div>

    <div class="home-features">
        <div class="home-feature-card">
            <div class="home-feature-icon" style="--icon-color:#3a5afe">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/></svg>
            </div>
            <h3>Модульный редактор</h3>
            <p>Собирайте кухню из готовых модулей — шкафы, ящики, фасады, столешницы.</p>
        </div>
        <div class="home-feature-card">
            <div class="home-feature-icon" style="--icon-color:#7c3afd">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="6"/><circle cx="12" cy="12" r="2"/></svg>
            </div>
            <h3>3D-визуализация</h3>
            <p>Мгновенный просмотр в реальном времени. Вращайте, приближайте, оценивайте.</p>
        </div>
        <div class="home-feature-card">
            <div class="home-feature-icon" style="--icon-color:#10b981">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>
            </div>
            <h3>Спецификация</h3>
            <p>Автоматический расчёт материалов, раскрой листов и экспорт в CSV.</p>
        </div>
        <div class="home-feature-card">
            <div class="home-feature-icon" style="--icon-color:#f59e0b">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 2L2 7l10 5 10-5-10-5z"/><path d="M2 17l10 5 10-5"/><path d="M2 12l10 5 10-5"/></svg>
            </div>
            <h3>Материалы</h3>
            <p>Библиотека текстур и декораторов. Назначайте любые материалы на детали.</p>
        </div>
        <div class="home-feature-card">
            <div class="home-feature-icon" style="--icon-color:#ef4444">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
            </div>
            <h3>Валидация</h3>
            <p>Автоматическая проверка пересечений, навески и зазоров между деталями.</p>
        </div>
        <div class="home-feature-card">
            <div class="home-feature-icon" style="--icon-color:#06b6d4">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M4 4h16v4H4z"/><path d="M4 10h16v4H4z"/><path d="M4 16h16v4H4z"/></svg>
            </div>
            <h3>MCP-управление</h3>
            <p>Удалённое управление через Model Context Protocol. Интеграция с ИИ-агентами.</p>
        </div>
    </div>
</div>
