@page "/"
@rendermode InteractiveServer

<PageTitle>KitchenDesigner</PageTitle>

<div class="home">
    <div class="hero">
        <div class="hero-bg"></div>
        <div class="hero-content">
            <div class="logo-icon">
                <svg viewBox="0 0 64 64" fill="none">
                    <rect x="8" y="20" width="48" height="36" rx="4" stroke="currentColor" stroke-width="2.5" fill="none"/>
                    <rect x="14" y="26" width="14" height="14" rx="2" stroke="currentColor" stroke-width="2" fill="none"/>
                    <rect x="36" y="26" width="14" height="14" rx="2" stroke="currentColor" stroke-width="2" fill="none"/>
                    <rect x="14" y="20" width="36" height="6" rx="1" fill="currentColor" opacity=".25"/>
                    <line x1="32" y1="20" x2="32" y2="56" stroke="currentColor" stroke-width="1.5" opacity=".3"/>
                    <circle cx="32" cy="10" r="5" stroke="currentColor" stroke-width="2" fill="none"/>
                    <line x1="32" y1="15" x2="32" y2="20" stroke="currentColor" stroke-width="1.5" opacity=".3"/>
                </svg>
            </div>
            <h1 class="hero-title">KitchenDesigner</h1>
            <p class="hero-sub">3D-конструктор кухонной мебели</p>

            <AuthorizeView>
                <Authorized>
                    <p class="hero-greeting">С возвращением, <strong>@context.User.Identity?.Name</strong></p>
                    <div class="hero-actions">
                        <a href="/projects" class="btn btn-primary">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 5v14M5 12h14"/></svg>
                            Проекты
                        </a>
                        <a href="/mcp-panel" class="btn btn-secondary">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="3" width="20" height="14" rx="2"/><path d="M8 21h8M12 17v4"/></svg>
                            MCP-сессии
                        </a>
                        <a href="/profile" class="btn btn-ghost">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="8" r="4"/><path d="M4 21a8 8 0 0 1 16 0"/></svg>
                            Профиль
                        </a>
                        <a href="/auth/logout" class="btn btn-danger">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4M16 17l5-5-5-5M21 12H9"/></svg>
                            Выйти
                        </a>
                    </div>
                </Authorized>
                <NotAuthorized>
                    <div class="hero-actions">
                        <a href="/auth/login" class="btn btn-primary">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4M10 17l5-5-5-5M15 12H3"/></svg>
                            Войти
                        </a>
                        <a href="/auth/register" class="btn btn-secondary">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><line x1="19" y1="8" x2="19" y2="14"/><line x1="22" y1="11" x2="16" y2="11"/></svg>
                            Создать аккаунт
                        </a>
                    </div>
                </NotAuthorized>
            </AuthorizeView>
        </div>
    </div>

    <div class="features">
        <div class="feature-card">
            <div class="feature-icon" style="--icon-color:#3a5afe">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/></svg>
            </div>
            <h3>Модульный редактор</h3>
            <p>Собирайте кухню из готовых модулей — шкафы, ящики, фасады, столешницы.</p>
        </div>
        <div class="feature-card">
            <div class="feature-icon" style="--icon-color:#7c3afd">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="6"/><circle cx="12" cy="12" r="2"/></svg>
            </div>
            <h3>3D-визуализация</h3>
            <p>Мгновенный просмотр в реальном времени. Вращайте, приближайте, оценивайте.</p>
        </div>
        <div class="feature-card">
            <div class="feature-icon" style="--icon-color:#10b981">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>
            </div>
            <h3>Спецификация</h3>
            <p>Автоматический расчёт материалов, раскрой листов и экспорт в CSV.</p>
        </div>
        <div class="feature-card">
            <div class="feature-icon" style="--icon-color:#f59e0b">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 2L2 7l10 5 10-5-10-5z"/><path d="M2 17l10 5 10-5"/><path d="M2 12l10 5 10-5"/></svg>
            </div>
            <h3>Материалы</h3>
            <p>Библиотека текстур и декораторов. Назначайте любые материалы на детали.</p>
        </div>
        <div class="feature-card">
            <div class="feature-icon" style="--icon-color:#ef4444">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
            </div>
            <h3>Валидация</h3>
            <p>Автоматическая проверка пересечений, навески и зазоров между деталями.</p>
        </div>
        <div class="feature-card">
            <div class="feature-icon" style="--icon-color:#06b6d4">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M4 4h16v4H4z"/><path d="M4 10h16v4H4z"/><path d="M4 16h16v4H4z"/></svg>
            </div>
            <h3>MCP-управление</h3>
            <p>Удалённое управление через Model Context Protocol. Интеграция с ИИ-агентами.</p>
        </div>
    </div>
</div>

<style>
    .home {
        flex: 1;
        display: flex;
        flex-direction: column;
        background: #0f0f1a;
        color: #ccc;
        font-family: 'Inter', system-ui, -apple-system, sans-serif;
    }

    /* ── Hero ── */
    .hero {
        position: relative;
        display: flex;
        justify-content: center;
        align-items: center;
        min-height: 420px;
        padding: 60px 24px;
        overflow: hidden;
    }
    .hero-bg {
        position: absolute;
        inset: 0;
        background:
            radial-gradient(ellipse 600px 400px at 30% 50%, rgba(58,90,254,.15) 0%, transparent 70%),
            radial-gradient(ellipse 500px 500px at 80% 30%, rgba(124,58,253,.10) 0%, transparent 60%),
            radial-gradient(ellipse 400px 300px at 50% 80%, rgba(16,185,129,.06) 0%, transparent 50%);
        pointer-events: none;
    }
    .hero-content {
        position: relative;
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
        max-width: 600px;
        animation: heroIn .8s ease-out;
    }
    @@keyframes heroIn {
        from { opacity: 0; transform: translateY(24px); }
        to   { opacity: 1; transform: translateY(0); }
    }

    .logo-icon {
        width: 72px;
        height: 72px;
        color: #3a5afe;
        margin-bottom: 16px;
        filter: drop-shadow(0 0 20px rgba(58,90,254,.4));
    }
    .hero-title {
        margin: 0;
        font-size: 44px;
        font-weight: 700;
        letter-spacing: -.03em;
        background: linear-gradient(135deg, #fff 40%, #3a5afe);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
    }
    .hero-sub {
        margin: 8px 0 0;
        font-size: 18px;
        color: #777;
        letter-spacing: .02em;
    }
    .hero-greeting {
        margin: 28px 0 0;
        font-size: 15px;
        color: #999;
    }
    .hero-greeting strong { color: #fff; }

    /* ── Buttons ── */
    .hero-actions {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 12px;
        margin-top: 28px;
    }
    .btn {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 10px 22px;
        border-radius: 10px;
        font-size: 14px;
        font-weight: 500;
        text-decoration: none;
        transition: all .2s;
        border: 1px solid transparent;
        cursor: pointer;
    }
    .btn svg { flex-shrink: 0; }
    .btn-primary {
        background: #3a5afe;
        color: #fff;
        box-shadow: 0 4px 14px rgba(58,90,254,.35);
    }
    .btn-primary:hover {
        background: #2948e0;
        transform: translateY(-2px);
        box-shadow: 0 6px 20px rgba(58,90,254,.45);
    }
    .btn-secondary {
        background: #2a2a3e;
        color: #ddd;
        border-color: #3a3a50;
    }
    .btn-secondary:hover {
        background: #35354f;
        color: #fff;
        transform: translateY(-2px);
    }
    .btn-ghost {
        background: transparent;
        color: #888;
    }
    .btn-ghost:hover {
        background: #2a2a3e;
        color: #fff;
    }
    .btn-danger {
        background: transparent;
        color: #f87171;
    }
    .btn-danger:hover {
        background: #3b1a1a;
        color: #ff9999;
    }

    /* ── Features ── */
    .features {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
        gap: 16px;
        padding: 0 24px 60px;
        max-width: 900px;
        margin: 0 auto;
        width: 100%;
        box-sizing: border-box;
    }
    .feature-card {
        display: flex;
        flex-direction: column;
        gap: 8px;
        padding: 20px;
        border-radius: 12px;
        background: #1a1a2e;
        border: 1px solid #2a2a3e;
        transition: all .25s;
    }
    .feature-card:hover {
        border-color: #3a3a55;
        transform: translateY(-4px);
        box-shadow: 0 8px 30px rgba(0,0,0,.4);
    }
    .feature-icon {
        width: 36px;
        height: 36px;
        color: var(--icon-color, #3a5afe);
        margin-bottom: 4px;
    }
    .feature-card h3 {
        margin: 0;
        font-size: 15px;
        font-weight: 600;
        color: #eee;
    }
    .feature-card p {
        margin: 0;
        font-size: 13px;
        line-height: 1.5;
        color: #888;
    }
</style>
