@page "/mcp-panel"
@rendermode InteractiveServer
@attribute [Authorize]
@using System.Security.Claims
@using KitchenServer.Web.Services
@using Microsoft.AspNetCore.Components.Authorization
@inject IJSRuntime JS
@inject McpSessionManager SessionManager
@inject McpUrlBuilder Urls
@inject NavigationManager Nav
@inject AuthenticationStateProvider AuthProvider

<PageTitle>MCP Sessions</PageTitle>

<div class="mcp-panel">
    <h1>MCP Sessions</h1>
    <p class="mcp-subtitle">Manage AI agent connections to your kitchen projects</p>

    <div class="create-section">
        <h2>Create New Session</h2>
        <div class="mcp-form-row">
            <input @bind="NewProjectId" placeholder="Project ID (optional)" class="mcp-input" />
            <button class="mcp-btn" @onclick="CreateSession" disabled="@IsCreating">
                @(IsCreating ? "Creating..." : "Create Session")
            </button>
        </div>
        @if (!string.IsNullOrEmpty(Error))
        {
            <p class="mcp-error">@Error</p>
        }
    </div>

    <div class="sessions-section">
        <h2>Active Sessions</h2>
        @if (Sessions == null)
        {
            <p>Loading...</p>
        }
        else if (Sessions.Count == 0)
        {
            <p class="mcp-empty">No active MCP sessions. Create one above.</p>
        }
        else
        {
            @foreach (var s in Sessions)
            {
                <div class="mcp-session-card">
                    <div class="mcp-session-header">
                        <span class="mcp-session-id">@s.SessionId</span>
                        <span class="mcp-badge @(s.IsActive ? "mcp-active" : "mcp-inactive")">
                            @(s.IsActive ? "Active" : "Inactive")
                        </span>
                    </div>
                    <div class="mcp-session-detail">Project: @(s.ProjectId ?? "—")</div>
                    <div class="mcp-session-detail">Created: @s.CreatedAt.ToString("g")</div>
                    <div class="mcp-session-detail">
                        <span class="mcp-label">MCP URL (agent):</span>
                        <code class="mcp-url">@HubUrl(s)</code>
                        <button class="mcp-btn mcp-btn-sm" @onclick="() => CopyToClipboard(HubUrl(s))">
                            Copy
                        </button>
                    </div>
                    <div class="mcp-session-detail">
                        <span class="mcp-label">WS URL (client):</span>
                        <code class="mcp-url">@WsUrl(s)</code>
                        <button class="mcp-btn mcp-btn-sm" @onclick="() => CopyToClipboard(WsUrl(s))">
                            Copy
                        </button>
                    </div>
                    <div class="mcp-session-detail">
                        <span class="mcp-label">Access Key:</span>
                        <code class="mcp-key">@s.AccessKey</code>
                        <button class="mcp-btn mcp-btn-sm" @onclick="() => CopyToClipboard(s.AccessKey)">
                            Copy
                        </button>
                    </div>
                    <button class="mcp-btn mcp-btn-danger" @onclick="() => CloseSession(s.SessionId)">
                        Revoke
                    </button>
                </div>
            }
        }
    </div>
</div>


@code {
    private string? NewProjectId;
    private bool IsCreating;
    private string? Error;
    private List<McpSession>? Sessions;
    private string _userId = "";

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthProvider.GetAuthenticationStateAsync();
        _userId = authState.User.FindFirst(ClaimTypes.NameIdentifier)?.Value ?? "";
        LoadSessions();
    }

    private void LoadSessions()
    {
        if (string.IsNullOrEmpty(_userId))
        {
            Error = "Not authenticated";
            return;
        }
        Sessions = SessionManager.GetUserSessions(_userId);
    }

    private string HubUrl(McpSession s) => Urls.HubUrl(Nav.BaseUri, s.AccessKey);
    private string WsUrl(McpSession s) => Urls.BrowserWsUrl(Nav.BaseUri, s.AccessKey);

    private void CreateSession()
    {
        IsCreating = true;
        Error = null;
        try
        {
            SessionManager.CreateSession(_userId,
                string.IsNullOrWhiteSpace(NewProjectId) ? null : NewProjectId.Trim());
            NewProjectId = null;
            LoadSessions();
        }
        catch (Exception ex)
        {
            Error = ex.Message;
        }
        finally
        {
            IsCreating = false;
        }
    }

    private void CloseSession(string sessionId)
    {
        var session = SessionManager.GetSession(sessionId);
        if (session != null && session.UserId == _userId)
            SessionManager.CloseSession(sessionId);
        LoadSessions();
    }

    private async Task CopyToClipboard(string text)
    {
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", text);
        }
        catch
        {
            // clipboard API unavailable (e.g. non-HTTPS or unsupported browser)
        }
    }
}
