@page "/editor/{projectId:guid}"
@rendermode InteractiveServer
@attribute [Authorize]
@using Microsoft.AspNetCore.Components.Authorization
@using KitchenServer.Web.Data
@using KitchenServer.Web.Endpoints
@using KitchenServer.Web.Services
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<AppDbContext> DbFactory
@inject AuthenticationStateProvider AuthProvider
@inject McpSessionManager McpSessions
@inject EditorNavState NavState
@inject IJSRuntime JS

@* The Unity WebGL client inside the iframe reads projectId and lockGuid from its
   query string and talks to /api/projects directly (same-origin cookies), so this
   page only hosts the frame. The build is served at /unity (UnityWebGLStaticFiles). *@

<PageTitle>@_projectName — KitchenDesigner Editor</PageTitle>

<div class="editor-page">
    @* Project name/ID live in the top-nav (see EditorNavInfo) — no separate toolbar row. *@
    @if (!string.IsNullOrEmpty(_error))
    {
        <div class="editor-error-banner">@_error</div>
    }

    <div class="editor-unity-container">
        @if (_ready)
        {
            <iframe src="@_iframeSrc"
                    class="editor-unity-frame"
                    allow="autoplay; fullscreen"
                    title="KitchenDesigner Editor">
            </iframe>
        }
        else
        {
            <div class="editor-loading">Loading project...</div>
        }
    </div>
</div>

@code {
    [Parameter] public Guid ProjectId { get; set; }

    private string _projectName = "Loading...";
    private string _error = "";
    private string _iframeSrc = "";
    private bool _ready;
    private string? _lockGuid;
    private bool _disposed;
    private McpSession? _session;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var authState = await AuthProvider.GetAuthenticationStateAsync();
            var userId = authState.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value ?? "";
            if (string.IsNullOrEmpty(userId))
            {
                _error = "Not authenticated.";
                return;
            }

            await using var db = await DbFactory.CreateDbContextAsync();
            var project = await db.Projects
                .FirstOrDefaultAsync(p => p.ProjectGroupId == ProjectId && p.UserId == userId && p.IsLatest && !p.IsDeleted);
            if (project is null)
            {
                _error = "Project not found.";
                return;
            }

            _projectName = project.Name;

            // Acquire project lock (takes over if already locked, notifies previous holder).
            var lockGuid = await ProjectLockHelper.AcquireLockAsync(db, McpSessions, project);
            if (lockGuid == null)
            {
                _error = "Failed to acquire project lock.";
                return;
            }
            _lockGuid = lockGuid;

            // Register beforeunload handler to release lock on tab close.
            var projectIdStr = ProjectId.ToString();
            var capturedLockGuid = _lockGuid;
            await JS.InvokeVoidAsync("editorLock.registerRelease",
                projectIdStr, capturedLockGuid);

            // Fresh MCP session for THIS tab: a unique project key generated on every
            // load. The WebGL client connects it to /api/mcp/ws; the user copies the
            // key (shown in the top nav, see EditorNavInfo) and passes it to the agent.
            _session = McpSessions.CreateSession(userId, ProjectId.ToString());
            McpSessions.SessionStateChanged += OnSessionStateChanged;
            _iframeSrc = $"/unity/index.html?projectId={ProjectId}" +
                         $"&lockGuid={Uri.EscapeDataString(_lockGuid)}" +
                         $"&mcpKey={Uri.EscapeDataString(_session.TabKey)}";

            _ready = true;
            NavState.Set(_projectName, ProjectId, _session.TabKey);
        }
        catch (Exception ex)
        {
            _error = $"Failed to load project: {ex.Message}";
        }
    }

    private async Task ReleaseLock()
    {
        if (_disposed || _lockGuid == null) return;
        _disposed = true;

        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            var project = await db.Projects
                .FirstOrDefaultAsync(p => p.ProjectGroupId == ProjectId && p.IsLatest);
            if (project != null)
                await ProjectLockHelper.ReleaseLockAsync(db, project, _lockGuid);
        }
        catch { /* best-effort cleanup */ }
    }

    // Flip the tab's status light when an agent binds/unbinds to THIS tab's key.
    private void OnSessionStateChanged(McpSession s)
    {
        if (_session == null || s.TabKey != _session.TabKey) return;
        InvokeAsync(() =>
        {
            NavState.SetAgentConnected(s.AgentBound);
            NavState.SetLockLost(s.LockLost);
        });
    }

    public async ValueTask DisposeAsync()
    {
        McpSessions.SessionStateChanged -= OnSessionStateChanged;
        if (_session != null) McpSessions.CloseSession(_session.TabKey);
        NavState.Clear();
        await ReleaseLock();
    }
}
