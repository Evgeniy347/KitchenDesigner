@page "/editor/{projectId:guid}"
@rendermode InteractiveServer
@attribute [Authorize]
@using Microsoft.AspNetCore.Components.Authorization
@using KitchenServer.Web.Data
@using KitchenServer.Web.Services
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<AppDbContext> DbFactory
@inject AuthenticationStateProvider AuthProvider
@inject McpSessionManager McpSessions

@* The Unity WebGL client inside the iframe reads projectId from its query string
   and talks to /api/projects directly (same-origin cookies), so this page only
   hosts the frame. The build is served at /unity (UnityWebGLStaticFiles). *@

<PageTitle>@_projectName — KitchenDesigner Editor</PageTitle>

<div class="editor-page">
    <div class="editor-toolbar">
        <div class="editor-toolbar-left">
            <a href="/projects" class="editor-back-link">← Projects</a>
            <span class="editor-project-name">@_projectName</span>
        </div>
        <div class="editor-toolbar-right">
            <span class="editor-project-id" title="Project ID: @ProjectId">ID: @ProjectId.ToString()[..8]</span>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(_error))
    {
        <div class="editor-error-banner">@_error</div>
    }

    <div class="editor-unity-container">
        @if (_ready)
        {
            <iframe src="@_iframeSrc"
                    class="editor-unity-frame"
                    allow="autoplay; fullscreen"
                    title="KitchenDesigner Editor">
            </iframe>
        }
        else
        {
            <div class="editor-loading">Loading project...</div>
        }
    </div>
</div>

@code {
    [Parameter] public Guid ProjectId { get; set; }

    private string _projectName = "Loading...";
    private string _error = "";
    private string _iframeSrc = "";
    private bool _ready;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var authState = await AuthProvider.GetAuthenticationStateAsync();
            var userId = authState.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value ?? "";
            if (string.IsNullOrEmpty(userId))
            {
                _error = "Not authenticated.";
                return;
            }

            await using var db = await DbFactory.CreateDbContextAsync();
            var project = await db.Projects.FirstOrDefaultAsync(p => p.Id == ProjectId && p.UserId == userId);
            if (project is null)
            {
                _error = "Project not found.";
                return;
            }

            _projectName = project.Name;

            // Если у пользователя есть MCP-сессия для этого проекта (или без
            // привязки к проекту) — прокидываем ключ: WebGL-клиент подключится
            // к /api/mcp/ws и агент сможет управлять сценой.
            var mcpSession = McpSessions.GetUserSessions(userId)
                .FirstOrDefault(s => s.ProjectId == null || s.ProjectId == ProjectId.ToString());
            _iframeSrc = $"/unity/index.html?projectId={ProjectId}" +
                         (mcpSession != null ? $"&mcpKey={Uri.EscapeDataString(mcpSession.AccessKey)}" : "");

            _ready = true;
        }
        catch (Exception ex)
        {
            _error = $"Failed to load project: {ex.Message}";
        }
    }
}

