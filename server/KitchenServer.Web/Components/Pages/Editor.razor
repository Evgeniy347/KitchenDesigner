@page "/editor/{projectId:guid}"
@rendermode InteractiveServer
@attribute [Authorize]
@using Microsoft.AspNetCore.Components.Authorization
@using KitchenServer.Web.Data
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<AppDbContext> DbFactory
@inject AuthenticationStateProvider AuthProvider

@* The Unity WebGL client inside the iframe reads projectId from its query string
   and talks to /api/projects directly (same-origin cookies), so this page only
   hosts the frame. The build is served at /unity (UnityWebGLStaticFiles). *@

<PageTitle>@_projectName — KitchenDesigner Editor</PageTitle>

<div class="editor-page">
    <div class="toolbar">
        <div class="toolbar-left">
            <a href="/projects" class="back-link">← Projects</a>
            <span class="project-name">@_projectName</span>
        </div>
        <div class="toolbar-right">
            <span class="project-id" title="Project ID: @ProjectId">ID: @ProjectId.ToString()[..8]</span>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(_error))
    {
        <div class="error-banner">@_error</div>
    }

    <div class="unity-container">
        @if (_ready)
        {
            <iframe src="/unity/index.html?projectId=@ProjectId"
                    class="unity-frame"
                    allow="autoplay; fullscreen"
                    title="KitchenDesigner Editor">
            </iframe>
        }
        else
        {
            <div class="loading">Loading project...</div>
        }
    </div>
</div>

@code {
    [Parameter] public Guid ProjectId { get; set; }

    private string _projectName = "Loading...";
    private string _error = "";
    private bool _ready;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var authState = await AuthProvider.GetAuthenticationStateAsync();
            var userId = authState.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value ?? "";
            if (string.IsNullOrEmpty(userId))
            {
                _error = "Not authenticated.";
                return;
            }

            await using var db = await DbFactory.CreateDbContextAsync();
            var project = await db.Projects.FirstOrDefaultAsync(p => p.Id == ProjectId && p.UserId == userId);
            if (project is null)
            {
                _error = "Project not found.";
                return;
            }

            _projectName = project.Name;
            _ready = true;
        }
        catch (Exception ex)
        {
            _error = $"Failed to load project: {ex.Message}";
        }
    }
}

<style>
    .editor-page {
        display: flex;
        flex-direction: column; 
        flex: 1; 
        min-height: 0;
        overflow: hidden;
    }
    .toolbar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 8px 16px;
        background: #1e1e2e;
        border-bottom: 1px solid #2a2a3e;
        flex-shrink: 0;
        min-height: 40px;
    }
    .toolbar-left {
        display: flex;
        align-items: center;
        gap: 16px;
    }
    .back-link {
        color: #3a5afe;
        text-decoration: none;
        font-size: 14px;
    }
    .back-link:hover { color: #5a7afe; }
    .project-name { color: #fff; font-size: 14px; font-weight: 600; }
    .toolbar-right {
        display: flex;
        align-items: center;
        gap: 16px;
    }
    .project-id { color: #666; font-size: 11px; font-family: monospace; }
    .unity-container {
        flex: 1;
        display: flex;
        background: #000;
    }
    .unity-frame {
        width: 100%; 
        border: none;
    }
    .loading {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 100%;
        color: #ccc;
        font-size: 16px;
    }
    .error-banner {
        padding: 8px 16px;
        background: #5a1a1a;
        color: #ff6b6b;
        font-size: 13px;
        flex-shrink: 0;
    }
</style>
