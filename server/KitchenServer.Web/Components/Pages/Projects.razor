@page "/projects"
@rendermode InteractiveServer
@attribute [Authorize]
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Forms
@using KitchenServer.Web.Data
@using Microsoft.EntityFrameworkCore
@using KitchenServer.Web.Services
@inject IDbContextFactory<AppDbContext> DbFactory
@inject ProjectStorageService Storage
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthProvider

<PageTitle>Projects — KitchenDesigner</PageTitle>

<div class="projects-page">
    <div class="projects-header">
        <h1>Projects</h1>
        <div class="projects-header-actions">
            <label class="projects-btn-secondary" title="Load a project from a .json file">
                <i class="bi bi-upload"></i> @(_importing ? "Importing..." : "Import")
                <InputFile OnChange="ImportFromFile" accept=".json" disabled="@_importing" class="projects-file-input-hidden" />
            </label>
            <button class="projects-btn-primary" @onclick="CreateNew">
                <i class="bi bi-plus-lg"></i> New Project
            </button>
        </div>
    </div>

    @if (_loading)
    {
        <p class="projects-loading">Loading...</p>
    }
    else if (!string.IsNullOrEmpty(_error))
    {
        <p class="projects-error">@_error</p>
    }
    else if (_projects.Count == 0)
    {
        <p class="projects-empty">No projects yet. Create your first one!</p>
    }
    else
    {
        <div class="projects-toolbar">
            <div class="projects-search-box">
                <i class="bi bi-search projects-search-icon"></i>
                <input type="text" placeholder="Search projects..." @bind="_filter" @bind:event="oninput"
                       class="projects-search-input" />
            </div>
        </div>

        <div class="projects-list">
            @foreach (var p in FilteredProjects)
            {
                <div class="projects-card">
                    <button class="projects-btn-play" @onclick="() => OpenProject(p.Id)"
                            title="Open project">
                        <i class="bi bi-play-fill"></i>
                    </button>
                    <div class="projects-card-body">
                        @if (_editingId == p.Id)
                        {
                            <div class="projects-rename-row">
                                <input type="text" @bind="_editName" class="projects-rename-input"
                                       @onkeydown="@(async e => { if (e.Key == "Enter") await RenameSave(p); if (e.Key == "Escape") CancelEdit(); })" />
                                <button class="projects-btn-small projects-btn-ghost" @onclick="CancelEdit">Cancel</button>
                                <button class="projects-btn-small" @onclick="() => RenameSave(p)">Save</button>
                            </div>
                        }
                        else
                        {
                            <span class="projects-card-name">@p.Name</span>
                        }
                        <span class="projects-card-date">@p.UpdatedAt.ToString("MMM dd, yyyy HH:mm")</span>
                    </div>
                    <div class="projects-card-actions">
                        <button class="projects-btn-icon" @onclick="() => StartRename(p)"
                                title="Rename">
                            <i class="bi bi-pencil"></i>
                        </button>
                        <button class="projects-btn-icon" @onclick="() => DuplicateProject(p.Id)"
                                title="Duplicate">
                            <i class="bi bi-files"></i>
                        </button>
                        <button class="projects-btn-icon projects-btn-icon-danger @(IsDeletePending(p.Id) ? "projects-btn-delete-confirm" : "")"
                                @onclick="() => ToggleDeleteConfirm(p.Id)"
                                title="Delete">
                            @if (IsDeletePending(p.Id))
                            {
                                <span class="projects-delete-confirm-text">sure?</span>
                            }
                            else
                            {
                                <i class="bi bi-trash"></i>
                            }
                        </button>
                    </div>
                </div>
            }
        </div>
    }
</div>

@code {
    private readonly List<ProjectInfo> _projects = new();
    private string _filter = "";
    private string _error = "";
    private bool _loading = true;
    private bool _importing;
    private Guid? _editingId;
    private string _editName = "";
    private Guid? _pendingDeleteId;

    private List<ProjectInfo> FilteredProjects =>
        string.IsNullOrWhiteSpace(_filter)
            ? _projects
            : _projects.Where(p => p.Name.Contains(_filter, StringComparison.OrdinalIgnoreCase)).ToList();

    protected override async Task OnInitializedAsync()
    {
        await LoadProjects();
    }

    private async Task LoadProjects()
    {
        _loading = true;
        _error = "";
        try
        {
            var authState = await AuthProvider.GetAuthenticationStateAsync();
            var userId = authState.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
            if (userId is null)
            {
                _error = "Not authenticated.";
                return;
            }

            _projects.Clear();
            await using var db = await DbFactory.CreateDbContextAsync();
            var dbProjects = await db.Projects
                .Where(p => p.UserId == userId && !p.IsArchived)
                .OrderByDescending(p => p.UpdatedAt)
                .Select(p => new ProjectInfo(p.Id, p.Name, p.CreatedAt, p.UpdatedAt))
                .ToListAsync();
            _projects.AddRange(dbProjects);
        }
        catch (Exception ex)
        {
            _error = $"Failed to load projects: {ex.Message}";
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task ImportFromFile(InputFileChangeEventArgs e)
    {
        _importing = true;
        _error = "";
        try
        {
            var authState = await AuthProvider.GetAuthenticationStateAsync();
            var userId = authState.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
            if (userId is null) return;

            var file = e.File;
            using var stream = file.OpenReadStream(Storage.MaxSizeBytes);
            using var reader = new System.IO.StreamReader(stream);
            var json = await reader.ReadToEndAsync();

            var name = System.IO.Path.GetFileNameWithoutExtension(file.Name);
            if (string.IsNullOrWhiteSpace(name))
                name = "Imported Project";

            var project = new KitchenServer.Web.Data.Entities.Project
            {
                Id = Guid.NewGuid(),
                UserId = userId,
                Name = name,
                JsonData = "{}",
                CreatedAt = DateTime.UtcNow,
                UpdatedAt = DateTime.UtcNow
            };

            // Storage.Save валидирует JSON и лимит размера — при отказе проект
            // в БД не попадает.
            await Storage.Save(project.Id, userId, json);

            await using var db = await DbFactory.CreateDbContextAsync();
            db.Projects.Add(project);
            await db.SaveChangesAsync();
            await LoadProjects();
        }
        catch (ProjectStorageException ex)
        {
            _error = ex.Message;
        }
        catch (System.IO.IOException)
        {
            _error = $"File is too large (limit {Storage.MaxSizeBytes / 1048576} MB)";
        }
        catch (Exception ex)
        {
            _error = $"Import failed: {ex.Message}";
        }
        finally
        {
            _importing = false;
        }
    }

    private async Task CreateNew()
    {
        try
        {
            var authState = await AuthProvider.GetAuthenticationStateAsync();
            var userId = authState.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
            if (userId is null) return;

            var project = new KitchenServer.Web.Data.Entities.Project
            {
                Id = Guid.NewGuid(),
                UserId = userId,
                Name = "New Project",
                JsonData = "{}",
                CreatedAt = DateTime.UtcNow,
                UpdatedAt = DateTime.UtcNow
            };

            await using var db = await DbFactory.CreateDbContextAsync();
            db.Projects.Add(project);
            await Storage.Save(project.Id, userId, "{}");
            await db.SaveChangesAsync();
            await LoadProjects();
        }
        catch (Exception ex)
        {
            _error = $"Failed to create project: {ex.Message}";
        }
    }

    private void OpenProject(Guid id) => Navigation.NavigateTo($"/editor/{id}");

    private void StartRename(ProjectInfo p)
    {
        _editingId = p.Id;
        _editName = p.Name;
        _pendingDeleteId = null;
    }

    private async Task RenameSave(ProjectInfo p)
    {
        if (string.IsNullOrWhiteSpace(_editName)) return;
        try
        {
            var authState = await AuthProvider.GetAuthenticationStateAsync();
            var userId = authState.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
            if (userId is null) return;

            await using var db = await DbFactory.CreateDbContextAsync();
            var project = await db.Projects.FirstOrDefaultAsync(pr => pr.Id == p.Id && pr.UserId == userId);
            if (project is not null)
            {
                project.Name = _editName;
                project.UpdatedAt = DateTime.UtcNow;
                await db.SaveChangesAsync();
            }
            CancelEdit();
            await LoadProjects();
        }
        catch (Exception ex)
        {
            _error = $"Failed to rename: {ex.Message}";
        }
    }

    private void CancelEdit()
    {
        _editingId = null;
        _editName = "";
    }

    private bool IsDeletePending(Guid id) => _pendingDeleteId == id;

    private async Task ToggleDeleteConfirm(Guid id)
    {
        if (_pendingDeleteId == id)
        {
            await DeleteProject(id);
        }
        else
        {
            _pendingDeleteId = id;
        }
    }

    private async Task DeleteProject(Guid id)
    {
        try
        {
            var authState = await AuthProvider.GetAuthenticationStateAsync();
            var userId = authState.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
            if (userId is null) return;

            await using var db = await DbFactory.CreateDbContextAsync();
            var project = await db.Projects.FirstOrDefaultAsync(p => p.Id == id && p.UserId == userId);
            if (project is not null)
            {
                db.Projects.Remove(project);
                await db.SaveChangesAsync();
                Storage.Delete(id, userId);
            }
            await LoadProjects();
        }
        catch (Exception ex)
        {
            _error = $"Failed to delete: {ex.Message}";
        }
    }

    private async Task DuplicateProject(Guid id)
    {
        try
        {
            var authState = await AuthProvider.GetAuthenticationStateAsync();
            var userId = authState.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
            if (userId is null) return;

            await using var db = await DbFactory.CreateDbContextAsync();
            var original = await db.Projects.FirstOrDefaultAsync(p => p.Id == id && p.UserId == userId);
            if (original is null) return;

            var json = await Storage.Load(id, userId) ?? original.JsonData;

            var duplicate = new KitchenServer.Web.Data.Entities.Project
            {
                Id = Guid.NewGuid(),
                UserId = userId,
                Name = $"{original.Name} (Copy)",
                JsonData = json,
                CreatedAt = DateTime.UtcNow,
                UpdatedAt = DateTime.UtcNow
            };

            db.Projects.Add(duplicate);
            await Storage.Save(duplicate.Id, userId, json);
            await db.SaveChangesAsync();
            await LoadProjects();
        }
        catch (Exception ex)
        {
            _error = $"Failed to duplicate: {ex.Message}";
        }
    }

    private record ProjectInfo(Guid Id, string Name, DateTime CreatedAt, DateTime UpdatedAt);
}

