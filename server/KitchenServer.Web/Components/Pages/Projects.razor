@page "/projects"
@rendermode InteractiveServer
@attribute [Authorize]
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Forms
@using KitchenServer.Web.Data
@using Microsoft.EntityFrameworkCore
@using KitchenServer.Web.Services
@inject IDbContextFactory<AppDbContext> DbFactory
@inject ProjectStorageService Storage
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthProvider

<PageTitle>Projects — KitchenDesigner</PageTitle>

<div class="projects-page">
    <div class="header">
        <h1>Projects</h1>
        <div class="header-actions">
            <label class="btn-secondary" title="Load a project from a .json file">
                <i class="bi bi-upload"></i> @(_importing ? "Importing..." : "Import")
                <InputFile OnChange="ImportFromFile" accept=".json" disabled="@_importing" class="file-input-hidden" />
            </label>
            <button class="btn-primary" @onclick="CreateNew">
                <i class="bi bi-plus-lg"></i> New Project
            </button>
        </div>
    </div>

    @if (_loading)
    {
        <p class="loading">Loading...</p>
    }
    else if (!string.IsNullOrEmpty(_error))
    {
        <p class="error">@_error</p>
    }
    else if (_projects.Count == 0)
    {
        <p class="empty">No projects yet. Create your first one!</p>
    }
    else
    {
        <div class="toolbar">
            <div class="search-box">
                <i class="bi bi-search search-icon"></i>
                <input type="text" placeholder="Search projects..." @bind="_filter" @bind:event="oninput"
                       class="search-input" />
            </div>
        </div>

        <div class="project-list">
            @foreach (var p in FilteredProjects)
            {
                <div class="project-card">
                    <button class="btn-play" @onclick="() => OpenProject(p.Id)"
                            title="Open project">
                        <i class="bi bi-play-fill"></i>
                    </button>
                    <div class="card-body">
                        @if (_editingId == p.Id)
                        {
                            <div class="rename-row">
                                <input type="text" @bind="_editName" class="rename-input"
                                       @onkeydown="@(async e => { if (e.Key == "Enter") await RenameSave(p); if (e.Key == "Escape") CancelEdit(); })" />
                                <button class="btn-small btn-ghost" @onclick="CancelEdit">Cancel</button>
                                <button class="btn-small" @onclick="() => RenameSave(p)">Save</button>
                            </div>
                        }
                        else
                        {
                            <span class="project-name">@p.Name</span>
                        }
                        <span class="project-date">@p.UpdatedAt.ToString("MMM dd, yyyy HH:mm")</span>
                    </div>
                    <div class="card-actions">
                        <button class="btn-icon" @onclick="() => StartRename(p)"
                                title="Rename">
                            <i class="bi bi-pencil"></i>
                        </button>
                        <button class="btn-icon" @onclick="() => DuplicateProject(p.Id)"
                                title="Duplicate">
                            <i class="bi bi-files"></i>
                        </button>
                        <button class="btn-icon btn-icon-danger @(IsDeletePending(p.Id) ? "btn-delete-confirm" : "")"
                                @onclick="() => ToggleDeleteConfirm(p.Id)"
                                title="Delete">
                            @if (IsDeletePending(p.Id))
                            {
                                <span class="delete-confirm-text">sure?</span>
                            }
                            else
                            {
                                <i class="bi bi-trash"></i>
                            }
                        </button>
                    </div>
                </div>
            }
        </div>
    }
</div>

@code {
    private readonly List<ProjectInfo> _projects = new();
    private string _filter = "";
    private string _error = "";
    private bool _loading = true;
    private bool _importing;
    private Guid? _editingId;
    private string _editName = "";
    private Guid? _pendingDeleteId;

    private List<ProjectInfo> FilteredProjects =>
        string.IsNullOrWhiteSpace(_filter)
            ? _projects
            : _projects.Where(p => p.Name.Contains(_filter, StringComparison.OrdinalIgnoreCase)).ToList();

    protected override async Task OnInitializedAsync()
    {
        await LoadProjects();
    }

    private async Task LoadProjects()
    {
        _loading = true;
        _error = "";
        try
        {
            var authState = await AuthProvider.GetAuthenticationStateAsync();
            var userId = authState.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
            if (userId is null)
            {
                _error = "Not authenticated.";
                return;
            }

            _projects.Clear();
            await using var db = await DbFactory.CreateDbContextAsync();
            var dbProjects = await db.Projects
                .Where(p => p.UserId == userId && !p.IsArchived)
                .OrderByDescending(p => p.UpdatedAt)
                .Select(p => new ProjectInfo(p.Id, p.Name, p.CreatedAt, p.UpdatedAt))
                .ToListAsync();
            _projects.AddRange(dbProjects);
        }
        catch (Exception ex)
        {
            _error = $"Failed to load projects: {ex.Message}";
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task ImportFromFile(InputFileChangeEventArgs e)
    {
        _importing = true;
        _error = "";
        try
        {
            var authState = await AuthProvider.GetAuthenticationStateAsync();
            var userId = authState.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
            if (userId is null) return;

            var file = e.File;
            using var stream = file.OpenReadStream(Storage.MaxSizeBytes);
            using var reader = new System.IO.StreamReader(stream);
            var json = await reader.ReadToEndAsync();

            var name = System.IO.Path.GetFileNameWithoutExtension(file.Name);
            if (string.IsNullOrWhiteSpace(name))
                name = "Imported Project";

            var project = new KitchenServer.Web.Data.Entities.Project
            {
                Id = Guid.NewGuid(),
                UserId = userId,
                Name = name,
                JsonData = "{}",
                CreatedAt = DateTime.UtcNow,
                UpdatedAt = DateTime.UtcNow
            };

            // Storage.Save валидирует JSON и лимит размера — при отказе проект
            // в БД не попадает.
            await Storage.Save(project.Id, userId, json);

            await using var db = await DbFactory.CreateDbContextAsync();
            db.Projects.Add(project);
            await db.SaveChangesAsync();
            await LoadProjects();
        }
        catch (ProjectStorageException ex)
        {
            _error = ex.Message;
        }
        catch (System.IO.IOException)
        {
            _error = $"File is too large (limit {Storage.MaxSizeBytes / 1048576} MB)";
        }
        catch (Exception ex)
        {
            _error = $"Import failed: {ex.Message}";
        }
        finally
        {
            _importing = false;
        }
    }

    private async Task CreateNew()
    {
        try
        {
            var authState = await AuthProvider.GetAuthenticationStateAsync();
            var userId = authState.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
            if (userId is null) return;

            var project = new KitchenServer.Web.Data.Entities.Project
            {
                Id = Guid.NewGuid(),
                UserId = userId,
                Name = "New Project",
                JsonData = "{}",
                CreatedAt = DateTime.UtcNow,
                UpdatedAt = DateTime.UtcNow
            };

            await using var db = await DbFactory.CreateDbContextAsync();
            db.Projects.Add(project);
            await Storage.Save(project.Id, userId, "{}");
            await db.SaveChangesAsync();
            await LoadProjects();
        }
        catch (Exception ex)
        {
            _error = $"Failed to create project: {ex.Message}";
        }
    }

    private void OpenProject(Guid id) => Navigation.NavigateTo($"/editor/{id}");

    private void StartRename(ProjectInfo p)
    {
        _editingId = p.Id;
        _editName = p.Name;
        _pendingDeleteId = null;
    }

    private async Task RenameSave(ProjectInfo p)
    {
        if (string.IsNullOrWhiteSpace(_editName)) return;
        try
        {
            var authState = await AuthProvider.GetAuthenticationStateAsync();
            var userId = authState.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
            if (userId is null) return;

            await using var db = await DbFactory.CreateDbContextAsync();
            var project = await db.Projects.FirstOrDefaultAsync(pr => pr.Id == p.Id && pr.UserId == userId);
            if (project is not null)
            {
                project.Name = _editName;
                project.UpdatedAt = DateTime.UtcNow;
                await db.SaveChangesAsync();
            }
            CancelEdit();
            await LoadProjects();
        }
        catch (Exception ex)
        {
            _error = $"Failed to rename: {ex.Message}";
        }
    }

    private void CancelEdit()
    {
        _editingId = null;
        _editName = "";
    }

    private bool IsDeletePending(Guid id) => _pendingDeleteId == id;

    private async Task ToggleDeleteConfirm(Guid id)
    {
        if (_pendingDeleteId == id)
        {
            await DeleteProject(id);
        }
        else
        {
            _pendingDeleteId = id;
        }
    }

    private async Task DeleteProject(Guid id)
    {
        try
        {
            var authState = await AuthProvider.GetAuthenticationStateAsync();
            var userId = authState.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
            if (userId is null) return;

            await using var db = await DbFactory.CreateDbContextAsync();
            var project = await db.Projects.FirstOrDefaultAsync(p => p.Id == id && p.UserId == userId);
            if (project is not null)
            {
                db.Projects.Remove(project);
                await db.SaveChangesAsync();
                Storage.Delete(id, userId);
            }
            await LoadProjects();
        }
        catch (Exception ex)
        {
            _error = $"Failed to delete: {ex.Message}";
        }
    }

    private async Task DuplicateProject(Guid id)
    {
        try
        {
            var authState = await AuthProvider.GetAuthenticationStateAsync();
            var userId = authState.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
            if (userId is null) return;

            await using var db = await DbFactory.CreateDbContextAsync();
            var original = await db.Projects.FirstOrDefaultAsync(p => p.Id == id && p.UserId == userId);
            if (original is null) return;

            var json = await Storage.Load(id, userId) ?? original.JsonData;

            var duplicate = new KitchenServer.Web.Data.Entities.Project
            {
                Id = Guid.NewGuid(),
                UserId = userId,
                Name = $"{original.Name} (Copy)",
                JsonData = json,
                CreatedAt = DateTime.UtcNow,
                UpdatedAt = DateTime.UtcNow
            };

            db.Projects.Add(duplicate);
            await Storage.Save(duplicate.Id, userId, json);
            await db.SaveChangesAsync();
            await LoadProjects();
        }
        catch (Exception ex)
        {
            _error = $"Failed to duplicate: {ex.Message}";
        }
    }

    private record ProjectInfo(Guid Id, string Name, DateTime CreatedAt, DateTime UpdatedAt);
}

<style>
    .projects-page {
        padding: 32px;
        width: 800px;
        margin: 0 auto;
        color: #ccc;
        font-family: sans-serif;
    }
    .header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 24px;
    }
    .header h1 { color: #fff; margin: 0; font-size: 24px; }
    .btn-primary {
        padding: 10px 20px;
        background: #3a5afe;
        color: #fff;
        border: none;
        border-radius: 4px;
        cursor: pointer;
        font-size: 14px;
        display: inline-flex;
        align-items: center;
        gap: 6px;
    }
    .btn-primary:hover { background: #2e4ecc; }
    .header-actions { display: flex; gap: 8px; align-items: center; }
    .btn-secondary {
        padding: 10px 20px;
        background: #2a2a3e;
        color: #ccc;
        border: 1px solid #3a3a5e;
        border-radius: 4px;
        cursor: pointer;
        font-size: 14px;
        display: inline-flex;
        align-items: center;
        gap: 6px;
    }
    .btn-secondary:hover { background: #3a3a5e; color: #fff; }
    .file-input-hidden { display: none; }
    .btn-small {
        padding: 4px 12px;
        border: none;
        border-radius: 3px;
        cursor: pointer;
        font-size: 12px;
        color: #ccc;
        background: #2a2a3e;
    }
    .btn-small:hover { background: #3a3a5e; }
    .btn-ghost { background: transparent; }
    .btn-ghost:hover { background: #2a2a3e; }
    .toolbar { margin-bottom: 16px; }
    .search-box {
        display: flex;
        align-items: center;
        background: #2a2a3e;
        border: 1px solid #3a3a5e;
        border-radius: 4px;
        padding: 0 12px;
    }
    .search-icon {
        color: #666;
        font-size: 16px;
        margin-right: 8px;
        flex-shrink: 0;
    }
    .search-input {
        flex: 1;
        padding: 8px 0;
        background: transparent;
        border: none;
        color: #fff;
        font-size: 14px;
        outline: none;
    }
    .search-input::placeholder { color: #666; }
    .project-list { display: flex; flex-direction: column; gap: 8px; }
    .project-card {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 12px 16px;
        background: #1e1e2e;
        border-radius: 6px;
        transition: background 0.15s;
    }
    .project-card:hover { background: #262640; }
    .btn-play {
        width: 36px;
        height: 36px;
        padding: 0;
        background: #28a745;
        color: #fff;
        border: none;
        border-radius: 50%;
        cursor: pointer;
        font-size: 18px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        transition: background 0.15s;
    }
    .btn-play:hover { background: #218838; }
    .btn-play i { font-size: 20px; }
    .card-body { display: flex; flex-direction: column; gap: 4px; flex: 1; min-width: 0; }
    .project-name { color: #fff; font-size: 15px; }
    .project-date { color: #888; font-size: 12px; }
    .card-actions { display: flex; gap: 4px; flex-shrink: 0; }
    .btn-icon {
        padding: 6px 8px;
        border: none;
        border-radius: 3px;
        cursor: pointer;
        font-size: 15px;
        color: #888;
        background: transparent;
        line-height: 1;
        min-width: 34px;
        min-height: 28px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        transition: background 0.15s, color 0.15s;
    }
    .btn-icon:hover { background: #2a2a3e; color: #ccc; }
    .btn-icon-danger:hover { background: #5a1a1a; color: #ff6b6b; }
