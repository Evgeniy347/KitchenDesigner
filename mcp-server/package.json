{
  "name": "unity-mcp-bridge",
  "version": "1.0.0",
  "private": true,
  "description": "MCP server bridge to Unity Kitchen Designer",
  "type": "module",
  "scripts": {
    "gen:tools": "dotnet run --project ../tools/McpContractGen -- src/tools.generated.ts",
    "check": "node scripts/check-parity.mjs",
    "prebuild": "node scripts/check-parity.mjs",
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.14.0"
  },
  "devDependencies": {
    "typescript": "^5.8.0",
    "@types/node": "^22.0.0"
  }
}
